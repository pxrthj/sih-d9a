# Copy to .env and fill in. Never commit the real file.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key. Bypasses row-level security, so it lives ONLY here and on
# the server — never in the frontend bundle, never in the repository.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio API key for Gemini.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash. Flash-Lite is cheaper but loses the
# small ink-jet MRP/batch blocks that appear on real packaging.
GEMINI_MODEL=gemini-3.5-flash

# Optional. Comma-separated origins allowed to call this API.
# Defaults to the local Vite dev server if unset.
CORS_ORIGINS=http://localhost:5173

# Optional. Public origin of the frontend, used to build the verification link
# and QR printed on each notice. Defaults to the local Vite dev server.
APP_BASE_URL=http://localhost:5173
