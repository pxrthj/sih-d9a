# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed variables,
# and bakes them in at BUILD time — change one and you must rebuild/redeploy.
#
# WHICH DATABASE: point this at the DEVELOPMENT Supabase project. Production's
# values live in the Vercel dashboard, not on a laptop. Under `npm run dev` a
# small badge in the bottom-left names the project you are attached to — if it
# reads as production, stop and fix this file before scanning anything, because
# inspection records cannot be deleted once written.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe to ship in the browser bundle: on its own it
# can only do what the RLS policies allow. Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=

# Backend base URL, no trailing slash.
# Local: http://127.0.0.1:8000   Deployed: https://<your-service>.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
